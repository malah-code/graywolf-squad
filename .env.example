# Graywolf Squad Environment Configuration
# Architecture: 4-Network Segmentation with Scoped Docker Socket Proxy (ADR-040)

NODE_ENV=development
PORT_CONTROL=3000
PORT_ARP=3001
DOCKER_HOST=tcp://localhost:2375
DATABASE_URL=postgresql://graywolf:graywolf_dev_secret@localhost:5432/graywolf_db
VALKEY_URL=redis://localhost:6379
LITELLM_URL=http://localhost:4000
RUNNER_DOCKER_NETWORK=graywolf-squad_runner-net
STORAGE_ROOT=./.agents
RELAY_JWT_SECRET=graywolf_dev_jwt_secret_must_be_32_chars_long!!
