# ==============================================================================
# Graywolf Squad — Production Docker Build Ignore Rules
# Excludes local developer state, secrets, heavy caches, and git history
# ==============================================================================

# Git & IDE metadata
.git/
.gitignore
.gitattributes
.github/
.vscode/
.idea/

# Local dependencies & caches
node_modules/
**/node_modules/
.npm/
.pnpm-store/
.cache/

# Local environment secrets & key files
.env
.env.local
.env.development
.env.test
.env.production
.graywolf/
*.key
*.pem
*.cert

# Local task storage, scratch pads & dataset collections
storage/
temp/
scratch/
.agents/dataset/
.agent_evidence.db
.agent_evidence.db*

# Test artifacts, logs & coverage reports
coverage/
test-results/
playwright-report/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Documentation & spec working artifacts (not needed in runtime container)
specs/
docs/
