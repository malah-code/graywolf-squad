# ==============================================================================
# Graywolf Squad Dashboard Multi-Stage Production Dockerfile (React + Vite + Nginx)
# Architecture: Node.js 20 Alpine (Build) -> Nginx 1.27 Alpine (Serve)
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build & Bundle Vite Dashboard SPA
# ------------------------------------------------------------------------------
FROM node:20-alpine AS builder

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy workspace configuration and manifests
COPY pnpm-workspace.yaml ./
COPY package.json ./
COPY pnpm-lock.yaml* ./
COPY src/dashboard/package.json ./src/dashboard/

# Install dashboard dependencies in workspace
RUN pnpm --filter graywolf-dashboard install --frozen-lockfile=false

# Copy dashboard source and build configurations
COPY src/dashboard ./src/dashboard

# Compile production SPA bundle into src/dashboard/dist
RUN pnpm --filter graywolf-dashboard build

# ------------------------------------------------------------------------------
# Stage 2: Hardened Nginx Static Asset Runtime
# ------------------------------------------------------------------------------
FROM nginx:1.27-alpine AS runner

# Remove default nginx configuration
RUN rm -rf /etc/nginx/conf.d/*

# Copy hardened custom Nginx configuration with SPA fallback & security headers
COPY docker/dashboard/nginx.conf /etc/nginx/conf.d/default.conf

# Copy compiled SPA bundle from builder stage
COPY --from=builder /app/src/dashboard/dist /usr/share/nginx/html

# Expose HTTP port 80
EXPOSE 80

HEALTHCHECK --interval=5s --timeout=3s --retries=5 --start-period=3s \
  CMD wget -q --spider http://localhost:80/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]

