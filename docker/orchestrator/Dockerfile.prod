# ==============================================================================
# Graywolf Squad Orchestrator Multi-Stage Production Dockerfile
# Architecture: Node.js 20 Alpine Linux Runtime (Multi-Arch amd64 & arm64)
# Security: Non-Root User graywolf (uid: 1001, gid: 1001)
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build & Compile TypeScript
# ------------------------------------------------------------------------------
FROM node:20-alpine AS builder

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@12.14.0 --activate

COPY package.json pnpm-lock.yaml* ./
RUN pnpm install --frozen-lockfile || pnpm install

COPY tsconfig.json tsconfig.build.json ./
COPY src/ ./src/

RUN pnpm build

# ------------------------------------------------------------------------------
# Stage 2: Production Runtime
# ------------------------------------------------------------------------------
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT_CONTROL=3000
ENV PORT_ARP=3001
ENV STORAGE_ROOT=/app/storage
ENV GRAYWOLF_KEK_PATH=/home/graywolf/.graywolf/master.key
ENV GRAYWOLF_MASTER_KEY_PATH=/home/graywolf/.graywolf/master.key

# Install ca-certificates and openssl for runtime TLS/crypto verification
RUN apk add --no-cache ca-certificates openssl

RUN corepack enable && corepack prepare pnpm@12.14.0 --activate

# Create unprivileged application user and group (uid/gid 1001)
RUN addgroup -g 1001 -S graywolf && \
    adduser -u 1001 -S graywolf -G graywolf

# Copy manifests and install production-only dependencies
COPY package.json pnpm-lock.yaml* ./
RUN pnpm install --prod --frozen-lockfile || pnpm install --prod

# Copy compiled TypeScript dist
COPY --from=builder /app/dist ./dist

# Copy database schema migrations for node-pg-migrate
COPY migrations/ ./migrations/

# Copy runtime relay harness scripts for in-container task execution
COPY src/relay/ ./src/relay/

# Copy pre-boot migration runner script
COPY scripts/db-migrate-init.sh ./scripts/db-migrate-init.sh
RUN chmod +x ./scripts/db-migrate-init.sh

# Pre-create runtime directories with strict graywolf ownership
RUN mkdir -p /home/graywolf/.graywolf /app/storage/tasks && \
    chmod 0700 /home/graywolf/.graywolf && \
    chown -R graywolf:graywolf /app /home/graywolf

# Drop privileges to non-root user
USER graywolf

# Dual Ports: 3000 (Control Plane REST/WS), 3001 (ARP WebSocket)
EXPOSE 3000 3001

HEALTHCHECK --interval=5s --timeout=3s --retries=5 --start-period=5s \
  CMD node -e 'require("http").get("http://localhost:3000/api/v1/health", (r) => process.exit(r.statusCode === 200 ? 0 : 1))'

CMD ["node", "dist/orchestrator/index.js"]

