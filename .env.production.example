# ==============================================================================
# Graywolf Squad — Production Environment Configuration (.env.production)
# Architecture: 4-Network Segmentation, Scoped Docker Proxy, Single Postgres Baseline
# Zero-Cost Platform: 100% Free under Elastic License 2.0 (ELv2)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Deployment Topology
# ------------------------------------------------------------------------------
NODE_ENV=production

# Deployment Topology Mode:
#   - solo: Developer workstation / edge host (e.g. Raspberry Pi 5). Zero SaaS egress.
#   - team: Internal team deployment with shared Valkey/Postgres and Casbin RBAC.
#   - enterprise: Multi-tenant deployment with strict RLS and OTLP monitoring.
DEPLOYMENT_TOPOLOGY=solo

# ------------------------------------------------------------------------------
# 2. Control Plane & ARP Listeners
# ------------------------------------------------------------------------------
# Port for Control Plane REST API, WebSockets, and Admin Dashboard
PORT_CONTROL=3000

# Dedicated Port for Agent Relay Protocol (ARP) WebSockets (runner-net only)
PORT_ARP=3001

# External HTTP Port for Web Dashboard (served via Nginx)
DASHBOARD_PORT=8080

# ------------------------------------------------------------------------------
# 3. Database & Cache Services (PostgreSQL 16 + pgvector, Valkey 7)
# ------------------------------------------------------------------------------
POSTGRES_USER=graywolf
POSTGRES_PASSWORD=CHANGE_ME_GENERATED_BY_INSTALLER
POSTGRES_DB=graywolf_db

# Valkey Max Memory Limit (default: 512mb; 256mb for <= 8GB RAM constrained edge hosts)
VALKEY_MAXMEMORY=512mb

# ------------------------------------------------------------------------------
# 4. Hardware Admission Profile & Task Concurrency (PRD §15)
# ------------------------------------------------------------------------------
# Maximum concurrent running task containers (default: 3; set to 1 on <= 8GB RAM hosts)
MAX_CONCURRENT_CONTAINERS=3

# Container Memory Limit per task runner (default: 2g)
CONTAINER_MEMORY_LIMIT=2g

# ------------------------------------------------------------------------------
# 5. Security Vault & Master Key Encryption Key (KEK) (ADR-018)
# ------------------------------------------------------------------------------
# Path to 256-bit AES Master Key (32 raw bytes, must be permission 0600)
GRAYWOLF_KEK_PATH=/home/graywolf/.graywolf/master.key
GRAYWOLF_MASTER_KEY_PATH=/home/graywolf/.graywolf/master.key

# Ephemeral ARP Relay JWT Signing Secret (must be >= 32 chars and non-default in production)
RELAY_JWT_SECRET=CHANGE_ME_RELAY_JWT_GENERATED_BY_INSTALLER

# Internal LiteLLM Gateway Authentication Key
LITELLM_MASTER_KEY=sk-graywolf-CHANGE_ME_GENERATED_BY_INSTALLER

# ------------------------------------------------------------------------------
# 6. Observability & OpenTelemetry (Optional, disabled by default)
# ------------------------------------------------------------------------------
# Set to true to export traces to an external OTLP receiver
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Strict Privacy Protection: Must remain false in shared/team topologies
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false

